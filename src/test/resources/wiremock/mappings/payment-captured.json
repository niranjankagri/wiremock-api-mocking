{
  "priority": 5,
  "request": {
    "method": "POST",
    "urlPath": "/v1/payments",
    "headers": { "Idempotency-Key": { "matches": ".+" } }
  },
  "response": {
    "status": 201,
    "headers": { "Content-Type": "application/json" },
    "body": "{\"id\":\"pay_{{jsonPath request.body '$.orderId'}}\",\"status\":\"captured\"}",
    "transformers": ["response-template"]
  }
}
