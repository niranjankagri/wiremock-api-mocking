{
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/v1/payments",
    "bodyPatterns": [{ "matchesJsonPath": "$[?(@.cardToken == 'tok_declined')]" }]
  },
  "response": {
    "status": 402,
    "headers": { "Content-Type": "application/json" },
    "jsonBody": { "code": "do_not_honor" }
  }
}
